<!-- Shared listing pagination -->
<% if @pagy.present? %>
  <nav aria-label="Pagination">
    <ul class="pagination d-flex flex-wrap align-items-center justify-content-end gap-2 mb-0">
      <li class="list-unstyled">
        <span class="btn btn-sm btn-light border text-secondary" aria-current="page">
          Page <%= @pagy.page %> of <%= @pagy.last %>
        </span>
      </li>
      <% [
           ["First", 1, @pagy.page > 1, "f"],
           ["Previous", @pagy.prev, @pagy.prev.present?, "p"],
           ["Next", @pagy.next, @pagy.next.present?, "n"],
           ["Last", @pagy.last, @pagy.page < @pagy.last, "l"]
         ].each do |label, number, enabled, shortcut| %>
        <li class="list-unstyled">
          <% if enabled %>
            <%= link_to label, url_for(params.to_unsafe_h.merge(page: number)),
                        class: "btn btn-sm btn-primary", accesskey: shortcut, target: "_self" %>
          <% else %>
            <span class="btn btn-sm btn-outline-secondary disabled" aria-disabled="true"><%= label %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>
<% end %>
