<!-- app/views/blogs/index.html.erb -->
<% content_for :title, "#{@site_information.site_name} - Blogs" %>
<%= render layout: "layouts/header" do %>
<% end %>

<section class="bg-light pt-5 text-secondary">
  <div class="container mb-5">
    <%= react_component('PostList',
                        {
                          # Visitors who are not signed in get the site's guest user, so say
                          # explicitly whether someone is signed in.
                          user: (@application_user&.as_json(only: %w[id name email access]) || {})
                                  .merge("logged_in" => user_signed_in?),
                          email: @application_user&.email,
                          blog_type: @blog_type }) %>
  </div>
</section>

<%= render layout: "layouts/footer" do %>
<% end %>
