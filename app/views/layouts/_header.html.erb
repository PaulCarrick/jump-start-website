<header>
  <div class="bg-light">
    <nav class="header-bg navbar navbar-dark navbar-expand-lg py-4 site-menu" data-controller="navigation" aria-label="Site menu">
      <div class="header-bg container">
        <!-- Brand Name -->
        <%= link_to @site_information.site_name,
                    root_path,
                    target: "_self",
                    class: "fs-2 fw-bold header-text nav-link text-uppercase",
                    style: "margin-top: 3px"
        %>

        <!-- Toggler Button for Hamburger Menu -->
        <%= button_tag type:  "button",
                       class: "navbar-toggler",
                       data:  { action: "navigation#toggle", navigation_target: "toggle" },
                       aria:  { controls: "navbarNav", expanded: "false", label: "Toggle navigation" } do %>
          <span class="navbar-toggler-icon"></span>
        <% end %>

        <!-- Collapsible Menu -->
        <div class="header-bg collapse navbar-collapse" id="navbarNav" data-navigation-target="menu">
          <ul class="header-bg ms-auto navbar-nav">
            <% @main_menu_items.each_with_index do |menu_item, index| %>
              <% next if hidden_navigation_item?(menu_item) %>
              <li class="header-bg nav-item">
                <% if menu_item.sub_items.publicly_enabled.any? %>
                  <!-- Dropdown Menu -->
                  <div class="header-bg dropdown <%= { "left" => "dropend", "right" => "dropstart", "bottom" => "dropup" }[site_menu_position] %>">
                    <%= link_to "#",
                                class: "header-bg header-text nav-link dropdown-toggle px-lg-3 py-lg-4 text-uppercase",
                                id:    "navbarDropdown-#{index}",
                                role:  "button",
                                data:  { bs_toggle: "dropdown" },
                                aria:  { expanded: "false" } do %>
                      <%= navigation_label(menu_item) %>
                    <% end %>
                    <ul class="header-bg dropdown-menu" aria-labelledby="navbarDropdown-#{index}">
                      <% menu_item.sub_items.publicly_enabled.map { |item| with_sign_out_link(item) }.each do |sub_item| %>
                        <% next if hidden_navigation_item?(sub_item) %>
                        <li>
                          <% link, method = sub_item[:link]&.split("|") %>

                          <% if method %>
                            <%= link_to navigation_label(sub_item), site_local_path(link), method: method.to_sym, class: "header-bg header-text dropdown-item", target: "_self" %>
                          <% else %>
                            <%= link_to navigation_label(sub_item), site_local_path(sub_item[:link]), class: "header-bg header-text dropdown-item", target: navigation_target(sub_item) %>
                          <% end %>
                        </li>
                      <% end %>
                    </ul>
                  </div>
                <% else %>
                  <!-- Regular Menu Item -->
                  <% if menu_item.options == "image-file" %>
                    <a href="<%= site_local_path(menu_item[:link]) %>" target="<%= navigation_target(menu_item) %>" rel="noopener">
                      <%= image_tag menu_item.icon,
                                    alt:   navigation_label(menu_item),
                                    class: "header-bg header-text nav-link px-lg-3 py-lg-4 text-uppercase"
                      %>
                    </a>
                  <% else %>
                    <% link, method = menu_item[:link]&.split("|") %>
                    <% if method %>
                      <%= link_to navigation_label(menu_item), site_local_path(link), method: method.to_sym, class: "header-text nav-link px-lg-3 py-lg-4 text-uppercase", target: "_self" %>
                    <% else %>
                      <%= link_to navigation_label(menu_item), site_local_path(menu_item[:link]), class: "header-text nav-link px-lg-3 py-lg-4 text-uppercase", target: navigation_target(menu_item) %>
                    <% end %>
                  <% end %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>
  </div>
</header>
<%= javascript_include_tag 'views/layouts/header' %>
