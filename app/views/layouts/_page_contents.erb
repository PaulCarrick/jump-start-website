<!-- /app/views/layouts/_page_contents.erb -->
<% if PublishingContext.preview %>
  <aside class="alert alert-warning">Draft preview — visible only to administrators. <%= link_to 'Review changes', admin_publishing_path, class: 'btn btn-primary ms-2' %></aside>
<% end %>

<style>
  <% if @site_information.present? %>
  :root {
      --header-bg: <%= @site_information.header_background %>;
      --header-text-color: <%= @site_information.header_text_color %>;
      --footer-bg: <%= @site_information.footer_background %>;
      --footer-text-color: <%= @site_information.footer_text_color %>;
      --container-bg: <%= @site_information.container_background %>;
      --container-text-color: <%= @site_information.container_text_color %>;
      --page-background-image: <%= @site_information.page_background_image %>;
  }

  <% end %>
</style>

<%= render layout: "layouts/header" do %>
<% end %>

<% if params[:data].present? %>
  <div class="align-content-center p-5">
    <h1>Welcome <%= params[:data][:name] %>!</h1>
  </div>
<% else %>
  <% @missing_image ||= image_path("missing-image.jpg") %>

  <% page_editing = @application_user&.admin? && @page.present? && page_editing_session?(@page) && params[:editing].present? %>
  <div class="<%= 'page-editing' if page_editing %>"
       <% if page_editing %>
       data-controller="page-editing"
       data-page-editing-workspace-value="<%= admin_page_workspace_path(@page) %>"
       data-page-editing-image-value="<%= admin_locate_image_file_path %>"
       data-page-editing-sections-value="<%= admin_page_editing_sections_path(@page) %>"
       data-page-editing-duplicate-value="<%= admin_duplicate_page_section_path(page_id: @page.id, id: "SECTION_ID") %>"
       data-action="contextmenu->page-editing#open"
       <% end %>>
  <section class="bg-light text-secondary auto-size">
    <div class="container mb-5">
      <p class="alert"><%= alert %></p>

      <div id="contents">
        <% move_units = page_editing ? section_move_units(@contents) : {} %>
        <% @contents.each do |content| %>
          <% section_classes = (@focused_section.present? && (@focused_section.section_name == content["section_name"])) ? 'highlight-section' : '' %>
          <div class="<%= section_classes %><%= ' page-editing-section' if page_editing %>"<% if page_editing %> data-section-id="<%= content['id'] %>" data-section-unit="<%= move_units[content['id']] %>" data-section-name="<%= content['section_name'] %>" data-section-group="<%= content['section_group'] %>"<% end %>>
            <%= react_component("RenderSection",
                                {
                                  section:  content,
                                  editing:  false,
                                  noBorder: true,
                                  noHidden: false
                                }
                )
            %>
          </div>
        <% end if @contents.present? %>
      </div>
      <div id="videoPlayer" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.8); z-index: 1000;">
        <div style="position: relative; width: 80%; max-width: 800px; margin: 50px auto; background: #fff; padding: 20px; border-radius: 10px;">
          <video id="videoElement" controls style="width: 100%;"></video>
          <button type="button" class="btn btn-danger" onclick="closeVideoPlayer()" style="display: block; margin: 20px auto;">
            Close
          </button>
        </div>
      </div>
      <input type="hidden" id="content-rendered-signal" value="true"/>
    </div>
  </section>

  <% if @application_user&.admin? && @page.present? %>
    <div class="page-edit-bar" data-page-editing-area="page">
      <% if page_editing %>
        <% waiting = Admin::PageEditingController.session_changes(session[:page_editing]).size %>
        <% others = Publishing.pending.size - waiting %>
        <%= button_to admin_page_editing_save_path(@page), method: :post, class: "btn btn-primary page-edit-save",
                      form: { class: "d-inline", data: { turbo: false } },
                      title: "Publish the changes made since you started editing" do %>
          <span class="page-edit-state">Editing…</span> Save Changes<%= " (#{waiting})" if waiting.positive? %>
        <% end %>
        <%= button_to "Cancel", admin_page_editing_cancel_path(@page), method: :post, class: "btn btn-outline-secondary",
                      form: { class: "d-inline", data: { turbo: false } },
                      onclick: (waiting.positive? ? "return confirm('Discard the #{waiting == 1 ? 'change' : "#{waiting} changes"} made since you started editing?');" : nil),
                      title: "Discard the changes made since you started editing" %>
        <span class="page-edit-hint">Right-click a picture, a column, the space around a section, or here to edit it.</span>
        <% if others.positive? %>
          <span class="page-edit-hint">
            <%= others == 1 ? "1 other change is" : "#{others} other changes are" %> waiting from before; Save and Cancel leave
            <%= others == 1 ? "it" : "them" %> alone (<%= link_to "Review and publish", admin_publishing_path, target: "_blank", rel: "noopener" %>).
          </span>
        <% end %>
      <% else %>
        <%= button_to "Edit Page", admin_page_editing_start_path(@page), method: :post, class: "btn btn-primary",
                      form: { class: "d-inline", data: { turbo: false } } %>
      <% end %>
      <% if notice.present? %><span class="page-edit-message" role="status"><%= notice %></span><% end %>
    </div>
  <% end %>
  </div>
<% end %>

<%= render layout: "layouts/footer" do %>

<% end %>
