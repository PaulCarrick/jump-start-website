<%= render layout: "layouts/admin_page" do %>
  <% if controller.get_item.present? %>
    <div class="mb-3">
      <%= react_component("RenderCell", { cell: controller.get_item, editing: false, noBorder: true, noHidden: true }) %>
    </div>
  <% end %>
  <%= link_to "Back to Cells", admin_return_url, class: "btn btn-secondary", target: "_self" %>
<% end %>
