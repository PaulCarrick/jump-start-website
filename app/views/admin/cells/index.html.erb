<!-- app/views/admin/cells/index.html.erb -->
<%= render layout: "layouts/admin_page" do %>
  <h1 class="mb-3">Manage Cells</h1>
  <div class="table-responsive">
    <table class="table admin-cells-table">
      <colgroup>
        <col style="width: 10%">
        <col style="width: 12%">
        <col style="width: 9%">
        <col style="width: 10%">
        <col style="width: 7%">
        <col style="width: 34%">
        <col style="width: 18%">
      </colgroup>
      <thead>
        <tr>
          <th scope="col"><%= sortable_column('Section', 'section_name', "cells") %></th>
          <th scope="col"><%= sortable_column('Name', 'cell_name', "cells") %></th>
          <th scope="col"><%= sortable_column('Order', 'cell_order', "cells") %></th>
          <th scope="col"><%= sortable_column('Image', 'image', "cells") %></th>
          <th scope="col"><%= sortable_column('Type', 'cell_type', "cells") %></th>
          <th scope="col" colspan="2">
            <div class="d-flex align-items-start justify-content-between flex-wrap gap-2">
              <%= column_heading("Cell") %>
              <div class="d-flex align-items-start justify-content-end flex-wrap gap-2 ms-auto">
                <%= link_to 'Clear Sort', admin_cells_path(clear_sort: true), class: "btn btn-secondary", target: "_self" %>
                <%= render 'shared/top_page_navigation' %>
              </div>
            </div>
          </th>
        </tr>
      </thead>
      <tbody>
        <% controller.get_items.each do |cell| %>
          <tr class="admin-cell-record">
            <td><%= cell.section_name %></td>
            <td><%= cell.cell_name %></td>
            <td><%= cell.cell_order %></td>
            <td><%= cell.image %></td>
            <td><%= cell.cell_type %></td>
            <td class="admin-cell-preview">
              <%= react_component("RenderCell", { cell: cell, editing: false, noBorder: true, noHidden: true }) %>
            </td>
            <td>
              <% delete_path = admin_cell_path(cell).to_s + "/delete" %>
              <%= action_links(cell, admin_cell_path(cell), edit_admin_cell_path(cell), delete_path) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="row mt-3">
    <div class="col-12 justify-content-end">
      <%= render 'shared/page_navigation' %>
    </div>
  </div>

  <%= search_form_for @q,
                      url:    admin_cells_path,
                      id:     "cells_search_form",
                      class:  "mt-3 p-2 rounded-box",
                      method: :get,
                      html:   { target: "_self", "data-turbo": "false", "data-turbolinks": "false" } do |form| %>
    <div class="row mb-2">
      <div class="col-2">
        <%= form.label :section_name_cont, "Section Name", class: "form-label" %>
      </div>
      <div class="col-4">
        <%= form.search_field :section_name_cont %>
      </div>
      <div class="col-2">
        <%= form.label :cell_name_cont, "Cell Name", class: "form-label" %>
      </div>
      <div class="col-4">
        <%= form.search_field :cell_name_cont, style: "min-width: 100%;" %>
      </div>
    </div>
    <div class="row mb-2">
      <div class="col-2">
        <%= form.label :image_cont, "Image", class: "form-label" %>
      </div>
      <div class="col-4">
        <%= form.search_field :image_cont, style: "min-width: 100%;" %>
      </div>
      <div class="col-2">
        <%= form.label :link_cont, "URL", class: "form-label" %>
      </div>
      <div class="col-4">
        <%= form.search_field :link_cont, style: "min-width: 100%;" %>
      </div>
    </div>
    <div class="row mb-2">
      <div class="col-2">
        <%= form.label :content_cont, "Content", class: "form-label" %>
      </div>
      <div class="col-10">
        <%= form.search_field :content_cont, style: "min-width: 100%;" %>
      </div>
    </div>
    <div>
      <%= form.submit "Search Cells", class: "btn btn-primary" %>
      <%= link_to 'Clear Search', admin_cells_path(clear_search: true), class: "btn btn-secondary", target: "_self" %>
    </div>
  <% end %>
<% end %>
