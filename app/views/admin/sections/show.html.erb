<%= render layout: "layouts/admin_page" do %>
  <% if controller.get_item.present? %>
    <div class="mb-3">
      <%= react_component("RenderSection", { section: controller.get_item.renderable_section, editing: false, noBorder: true, noHidden: true }) %>
    </div>
  <% end %>
  <%= link_to "Back to Sections", admin_return_url, class: "btn btn-secondary", target: "_self" %>
<% end %>
