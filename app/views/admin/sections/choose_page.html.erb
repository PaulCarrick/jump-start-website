<!-- app/views/admin/sections/choose_page.html.erb -->
<%= render layout: "layouts/admin_page" do %>
  <h1 class="mb-3">New Section</h1>
  <% if @pages.empty? %>
    <p>A section belongs to a page. There are no pages yet.</p>
    <%= link_to "New Page", new_admin_page_path, class: "btn btn-primary", target: "_self" %>
  <% else %>
    <p>A section belongs to a page. Choose the page to add it to.</p>
    <%= form_with url: new_admin_section_path, method: :get, local: true, data: { turbo: false } do %>
      <div class="row mb-3">
        <label for="page_id" class="col-2 col-form-label">Page:</label>
        <div class="col-5">
          <%= select_tag :page_id,
                         options_for_select(@pages.map { |page| [ page.title.presence || page.name, page.id ] }),
                         class: "form-select", required: true %>
        </div>
      </div>
      <%= submit_tag "Continue", name: nil, class: "btn btn-primary me-3" %>
      <%= link_to "Cancel", admin_sections_path, class: "btn btn-secondary", target: "_self" %>
    <% end %>
  <% end %>
<% end %>
