<!-- app/views/admin/pages/index.html.erb -->
<%= render layout: "layouts/admin_page" do %>
  <%= admin_list_heading("Pages", count: @pagy&.count || controller.get_items.size, new_label: "New page", new_path: new_admin_page_path) %>
  <div class="admin-list-tools">
    <%= admin_search_box(admin_pages_path, "title_or_name_or_section_cont", placeholder: "Search pages by title, name or section") %>
    <%= link_to "Clear Sort", '#', class: "admin-clear-sort", onclick: "clearSort()" %>
  </div>
  <div class="admin-table-box">
    <table class="admin-table">
      <thead>
        <tr>
          <th scope="col"><%= admin_sort_heading("Title", "title", "pages") %></th>
          <th scope="col"><%= admin_sort_heading("Name", "name", "pages") %></th>
          <th scope="col"><%= admin_sort_heading("Section", "section", "pages") %></th>
          <th scope="col"><%= admin_sort_heading("Access", "access", "pages") %></th>
          <th scope="col">Status</th>
          <th scope="col"><span class="visually-hidden">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% controller.get_items.each do |page| %>
          <tr class="admin-list-record">
            <td class="admin-cell-title"><%= link_to(page.title.presence || page.name, admin_page_workspace_path(page), target: "_self") %></td>
            <td class="admin-cell-muted">/<%= page.name %></td>
            <td><%= page.section %></td>
            <td><%= page.access.presence || "Everyone" %></td>
            <td><%= admin_status_badge(page) %></td>
            <td class="admin-cell-actions">
              <%= admin_row_actions(page, show_path: admin_page_path(page), edit_path: admin_page_workspace_path(page), delete_path: admin_page_path(page),
                                    extra_links: [ [ "Classic editor", edit_admin_page_path(page) ] ]) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if controller.get_items.empty? %>
      <p class="admin-list-empty">No pages found.</p>
    <% end %>
  </div>
  <div class="admin-list-footer"><%= render 'shared/page_navigation' %></div>
<% end %>
