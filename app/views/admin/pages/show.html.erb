<!-- app/views/admin/pages/show.html.erb -->
<%= render layout: "layouts/admin_page" do %>
  <div>
    <% sections = controller.get_sections %>
    <% if sections.present? %>
      <% sections.each_with_index do |section, index| %>
        <%= render "admin/sections/divider", previous: sections[index - 1], section: section if index.positive? %>
        <%= react_component("RenderSection",
                            {
                              section:  section.renderable_section,
                              editing:  true,
                              noBorder: true,
                              noHidden: true
                            }
            )
        %>
      <% end %>
    <% else %>
      <h1>No Content</h1>
    <% end %>
  </div>
<% end %>
