<!-- app/views/admin/footer_items/index.html.erb -->
<%= render layout: "layouts/admin_page" do %>
  <%= admin_list_heading("Footer", count: @pagy&.count || controller.get_items.size, new_label: "New Footer Item", new_path: new_admin_footer_item_path) %>
  <div class="admin-list-tools">
    <%= admin_search_box(admin_footer_items_path, "label_or_link_cont", placeholder: "Search footer items by label or link") %>
    <%= link_to "Clear Sort", '#', class: "admin-clear-sort", onclick: "clearSort()" %>
  </div>
  <div class="admin-table-box">
    <table class="admin-table">
      <thead>
        <tr>
          <th scope="col"><%= admin_sort_heading("Label", "label", "footer_items") %></th>
          <th scope="col"><%= admin_sort_heading("Footer Order", "footer_order", "footer_items") %></th>
          <th scope="col"><%= admin_sort_heading("Link", "link", "footer_items") %></th>
          <th scope="col">Status</th>
          <th scope="col"><span class="visually-hidden">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% controller.get_items.each do |footer_item| %>
          <tr class="admin-list-record">
            <td class="admin-cell-title"><%= link_to(footer_item.label, edit_admin_footer_item_path(footer_item), target: "_self") %></td>
            <td><%= footer_item.footer_order %></td>
            <td class="admin-cell-muted"><%= footer_item.link %></td>
            <td><%= admin_status_badge(footer_item) %></td>
            <td class="admin-cell-actions">
              <%= admin_row_actions(footer_item, show_path: admin_footer_item_path(footer_item), edit_path: edit_admin_footer_item_path(footer_item), delete_path: admin_footer_item_path(footer_item)) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if controller.get_items.empty? %>
      <p class="admin-list-empty">No footer items found.</p>
    <% end %>
  </div>
  <div class="admin-list-footer"><%= render 'shared/page_navigation' %></div>
<% end %>
