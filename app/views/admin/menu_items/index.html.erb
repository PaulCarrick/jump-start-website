<!-- app/views/admin/menu_items/index.html.erb -->
<%= render layout: "layouts/admin_page" do %>
  <%= admin_list_heading("Header menu", count: @pagy&.count || controller.get_items.size, new_label: "New Menu Item", new_path: new_admin_menu_item_path) %>
  <div class="admin-list-tools">
    <%= admin_search_box(admin_menu_items_path, "label_or_link_cont", placeholder: "Search menu items by label or link") %>
    <%= link_to "Clear Sort", '#', class: "admin-clear-sort", onclick: "clearSort()" %>
  </div>
  <div class="admin-table-box">
    <table class="admin-table">
      <thead>
        <tr>
          <th scope="col"><%= admin_sort_heading("Label", "label", "menu_items") %></th>
          <th scope="col"><%= admin_sort_heading("Menu Type", "menu_type", "menu_items") %></th>
          <th scope="col"><%= admin_sort_heading("Menu Order", "menu_order", "menu_items") %></th>
          <th scope="col"><%= admin_sort_heading("Link", "link", "menu_items") %></th>
          <th scope="col"><%= admin_sort_heading("Access", "access", "menu_items") %></th>
          <th scope="col">Status</th>
          <th scope="col"><span class="visually-hidden">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% controller.get_items.each do |menu_item| %>
          <tr class="admin-list-record">
            <td class="admin-cell-title"><%= link_to(menu_item.label, edit_admin_menu_item_path(menu_item), target: "_self") %></td>
            <td><%= menu_item.menu_type %></td>
            <td><%= menu_item.menu_order %></td>
            <td class="admin-cell-muted"><%= menu_item.link %></td>
            <td><%= menu_item.access.presence || "Everyone" %></td>
            <td><%= admin_status_badge(menu_item) %></td>
            <td class="admin-cell-actions">
              <%= admin_row_actions(menu_item, show_path: admin_menu_item_path(menu_item), edit_path: edit_admin_menu_item_path(menu_item), delete_path: admin_menu_item_path(menu_item)) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if controller.get_items.empty? %>
      <p class="admin-list-empty">No menu items found.</p>
    <% end %>
  </div>
  <div class="admin-list-footer"><%= render 'shared/page_navigation' %></div>
<% end %>
