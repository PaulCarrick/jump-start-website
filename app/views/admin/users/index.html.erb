<!-- app/views/admin/users/index.html.erb -->
<%= render layout: "layouts/admin_page" do %>
  <%= admin_list_heading("Users", count: @pagy&.count || @users.to_a.size, new_label: "New User", new_path: new_admin_user_path) %>
  <div class="admin-list-tools">
    <%= admin_search_box(admin_users_path, "email_or_name_cont", placeholder: "Search users by email or name") %>
  </div>
  <div class="admin-table-box">
    <table class="admin-table">
      <thead>
        <tr>
          <th scope="col"><%= admin_sort_heading("Email", "email", "users") %></th>
          <th scope="col"><%= admin_sort_heading("Name", "name", "users") %></th>
          <th scope="col"><%= admin_sort_heading("Access", "access", "users") %></th>
          <th scope="col"><%= admin_sort_heading("Roles", "roles", "users") %></th>
          <th scope="col">Status</th>
          <th scope="col"><span class="visually-hidden">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% (@users || []).each do |user| %>
          <tr class="admin-list-record">
            <td class="admin-cell-title"><%= link_to(user.email, edit_admin_user_path(user), target: "_self") %></td>
            <td><%= user.name.presence || "N/A" %></td>
            <td><%= user.access %></td>
            <td class="admin-cell-muted"><%= user.roles.presence || "None" %></td>
            <td><%= admin_status_badge(user) %></td>
            <td class="admin-cell-actions">
              <%= admin_row_actions(user, show_path: admin_user_path(user), edit_path: edit_admin_user_path(user), delete_path: admin_user_path(user)) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @users.blank? %>
      <p class="admin-list-empty">No users found.</p>
    <% end %>
  </div>
  <div class="admin-list-footer"><%= render "shared/page_navigation" %></div>
<% end %>
