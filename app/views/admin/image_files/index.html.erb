<!-- app/views/admin/image_files/index.html.erb -->
<%
  current_group = @q&.conditions&.find { |condition| condition.key == "group_eq" }&.value
  showing_ungrouped = @q&.conditions&.any? { |condition| condition.key == "group_blank" }
  filtered = @q&.conditions.present?
  library_path = ->(options = {}) { admin_image_files_path({ page: params[:page] }.compact.merge(options)) }
  can_change = @application_user&.admin?
%>
<%= render layout: "layouts/admin_page" do %>
  <div class="admin-list-heading">
    <h1 class="admin-page-title">Media</h1>
    <span class="admin-list-count"><%= pluralize(@pagy&.count || controller.get_items.size, "file") %><%= " found" if filtered %></span>
    <%= link_to("New Image", new_admin_image_file_path, class: "btn btn-outline-primary admin-list-new", target: "_self",
                title: "Add one image with its caption and description") %>
  </div>

  <% if can_change %>
    <%= form_tag(admin_upload_image_files_path, method: :post, multipart: true, class: "admin-dropzone",
                 data: { controller: "media-upload", turbo: false, action: "dragover->media-upload#over dragleave->media-upload#leave drop->media-upload#drop" }) do %>
      <div class="admin-dropzone-text">
        <strong>Drop images or MP4 videos here</strong>
        <span>or <label for="media-upload-files" class="admin-dropzone-choose">choose files</label> — up to <%= Admin::ImageFilesController::MAX_UPLOAD_FILES %> at a time. Each is named after its file.</span>
        <span class="admin-dropzone-chosen" data-media-upload-target="chosen" aria-live="polite"></span>
      </div>
      <%= file_field_tag "files[]", id: "media-upload-files", multiple: true, accept: "image/*,video/mp4", class: "visually-hidden",
                         data: { media_upload_target: "input", action: "change->media-upload#chosen" } %>
      <label class="admin-dropzone-group">
        <span>Add to group (optional)</span>
        <%= text_field_tag :group, current_group, class: "form-control", list: "media-groups", placeholder: "No group" %>
      </label>
      <%= submit_tag "Upload", class: "btn btn-primary", disabled: true, data: { media_upload_target: "submit" } %>
    <% end %>
  <% end %>

  <div class="admin-list-tools">
    <%= admin_search_box(admin_image_files_path, "name_or_caption_or_description_or_group_cont", placeholder: "Search by name, caption, description or group") %>
  </div>

  <nav class="admin-chips" aria-label="Filter by group">
    <%= link_to("All", admin_image_files_path(clear_search: true), class: "admin-chip#{' is-current' unless filtered}", target: "_self") %>
    <% @group_counts.each do |group, count| %>
      <%= link_to(admin_image_files_path("q[group_eq]" => group), class: "admin-chip#{' is-current' if current_group == group}", target: "_self") do %>
        <%= group %> <span class="admin-chip-count"><%= count %></span>
      <% end %>
    <% end %>
    <% if @ungrouped_count.positive? %>
      <%= link_to(admin_image_files_path("q[group_blank]" => "1"), class: "admin-chip#{' is-current' if showing_ungrouped}", target: "_self") do %>
        No group <span class="admin-chip-count"><%= @ungrouped_count %></span>
      <% end %>
    <% end %>
  </nav>

  <% if can_change && @group_slides.present? %>
    <section class="admin-slide-order" aria-labelledby="slide-order-title"
             data-controller="slide-order"
             data-slide-order-url-value="<%= admin_image_files_group_order_path %>"
             data-slide-order-group-value="<%= current_group %>">
      <div class="admin-slide-order-head">
        <h2 class="admin-panel-title" id="slide-order-title">Slide show order</h2>
        <span class="form-text">Drag a picture to a new place, or click one and use ← and →. The order is saved as a draft.</span>
        <span class="admin-slide-order-status" data-slide-order-target="status" role="status" aria-live="polite"></span>
      </div>
      <ol class="admin-slide-strip" data-slide-order-target="list">
        <% @group_slides.each_with_index do |image_file, index| %>
          <li class="admin-slide<%= ' is-hidden' unless image_file.enabled %>" tabindex="0"
              data-id="<%= image_file.id %>" data-name="<%= image_file.name %>"
              aria-label="<%= image_file.name %>, slide <%= index + 1 %> of <%= @group_slides.size %>"
              title="Drag to move <%= image_file.name %>"
              data-action="pointerdown->slide-order#grab pointermove->slide-order#drag pointerup->slide-order#drop pointercancel->slide-order#drop keydown->slide-order#key">
            <span class="admin-slide-number" aria-hidden="true"><%= index + 1 %></span>
            <% if image_file.image.attached? && image_file.mime_type == "video/mp4" %>
              <span class="admin-slide-thumb admin-slide-video" aria-hidden="true">▶</span>
            <% elsif image_file.image.attached? %>
              <img class="admin-slide-thumb" src="<%= image_file.image_url %>" alt="" loading="lazy" decoding="async" draggable="false">
            <% else %>
              <span class="admin-slide-thumb" aria-hidden="true"></span>
            <% end %>
            <span class="admin-slide-name"><%= image_file.name %></span>
          </li>
        <% end %>
      </ol>
    </section>
  <% end %>

  <div class="admin-media">
    <div>
      <% if controller.get_items.empty? %>
        <p class="admin-list-empty admin-table-box">No files found.</p>
      <% end %>
      <ul class="admin-media-grid">
        <% controller.get_items.each do |image_file| %>
          <li class="admin-media-card<%= ' is-selected' if @selected&.id == image_file.id %><%= ' is-hidden' unless image_file.enabled %>" data-image-id="<%= image_file.id %>">
            <%= link_to(library_path.call(selected: image_file.id), class: "admin-media-thumb", target: "_self",
                        title: "Details of #{image_file.name}", aria: { label: "Details of #{image_file.name}" }) do %>
              <% if !image_file.image.attached? %>
                <span class="admin-media-missing">No file</span>
              <% elsif image_file.mime_type == "video/mp4" %>
                <video src="<%= image_file.image_url %>#t=0.1" preload="metadata" muted playsinline></video>
                <span class="admin-media-play" aria-hidden="true">▶</span>
              <% else %>
                <img src="<%= image_file.image_url %>" alt="" loading="lazy" decoding="async">
              <% end %>
            <% end %>
            <div class="admin-media-meta">
              <span class="admin-media-name" title="<%= image_file.name %>"><%= image_file.name %></span>
              <span class="admin-media-sub">
                <%= image_file.group.presence || "No group" %>
                <% unless image_file.enabled %> · Hidden<% end %>
                <% if image_file.respond_to?(:temporal_state) && image_file.temporal_state == "draft" %> · Draft<% end %>
              </span>
            </div>
          </li>
        <% end %>
      </ul>
      <div class="admin-list-footer"><%= render 'shared/page_navigation' %></div>
    </div>

    <aside class="admin-menu-panel admin-media-panel<%= ' is-empty' unless @selected %>" aria-label="Details of the chosen file">
      <% if @selected %>
        <%= render "details", image_file: @selected, library_path: library_path, can_change: can_change %>
      <% else %>
        <div class="admin-panel-empty">
          <h2 class="admin-panel-title">Choose a file</h2>
          <p class="form-text">Click a picture to see its details, where it is used, and to change its group.</p>
        </div>
      <% end %>
    </aside>
  </div>

  <datalist id="media-groups">
    <% @group_counts.each_key do |group| %>
      <option value="<%= group %>"></option>
    <% end %>
  </datalist>
<% end %>
