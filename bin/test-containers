#!/usr/bin/env python3
"""Test a fresh install in isolated volumes; remove only this test project."""
import os
from pathlib import Path
import secrets
import subprocess
import tempfile

root = Path(__file__).resolve().parents[1]
project = 'jumpstart-test-' + secrets.token_hex(4)
with tempfile.TemporaryDirectory() as directory:
    subprocess.run([str(root / 'bin/docker-setup')], cwd=directory, check=True)
    command = ['docker', 'compose', '--project-directory', str(root), '--env-file', str(Path(directory) / '.env'), '-p', project]
    def run(*args, **kwargs):
        return subprocess.run(command + list(args), check=True, **kwargs)
    try:
        # No host port collision; only test containers can access the application.
        override = Path(directory) / 'test.yml'
        override.write_text('services:\n  rails:\n    ports: !reset []\n')
        command += ['-f', str(root / 'compose.yml'), '-f', str(override)]
        run('up', '-d', '--build', '--wait', '--wait-timeout', '300')
        run('exec', '-T', 'rails', 'bundle', 'exec', 'rails', 'runner',
            "raise 'admin missing' unless User.unscoped.where(email: ENV.fetch('ADMIN_EMAIL'), access: 'super').exists?; File.write(Rails.root.join('storage/container-test'), 'persistent')")
        run('exec', '-T', 'rails', 'curl', '-fsS', '-H', 'Host: localhost', 'http://127.0.0.1:3000/users/sign_in', stdout=subprocess.DEVNULL)
        run('restart')
        run('up', '-d', '--wait', '--wait-timeout', '300')
        run('exec', '-T', 'rails', 'bundle', 'exec', 'rails', 'runner',
            "raise 'upload lost' unless File.read(Rails.root.join('storage/container-test')) == 'persistent'; raise 'account lost' unless User.unscoped.where(email: ENV.fetch('ADMIN_EMAIL')).count == 1")
        print('Fresh install, login page, accounts, and restart persistence passed.')
    except Exception:
        run('logs', '--no-color')
        raise
    finally:
        run('down', '-v', '--remove-orphans')
