#!/usr/bin/env bash
set -euo pipefail

LABEL="com.paulcarrick.jump-start-website-dev"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
LOG_DIR="$HOME/Library/Logs"
SUPPORT_DIR="$HOME/Library/Application Support/jump-start-website"
ENV_FILE="$SUPPORT_DIR/dev-server.env"
RUNNER="$SUPPORT_DIR/run-dev-server"
RUBY_BIN="/opt/homebrew/opt/ruby@3.2/bin/ruby"

if [[ ! -x "$RUBY_BIN" ]]; then
  echo "Native Homebrew Ruby 3.2 was not found at:"
  echo "  $RUBY_BIN"
  exit 1
fi

GEM_BINDIR="$("$RUBY_BIN" -e 'print Gem.bindir')"
PATH_VALUE="/opt/homebrew/opt/ruby@3.2/bin:$GEM_BINDIR:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"

mkdir -p "$HOME/Library/LaunchAgents" "$LOG_DIR" "$SUPPORT_DIR"

if [[ -z "${DB_PASSWORD:-}" ]]; then
  echo "DB_PASSWORD is not set in this shell."
  echo "Set it first, then run bin/install-dev-server again."
  exit 1
fi

# Store only the local development variables needed by Rails.
# This file is outside the repository and readable only by the current user.
{
  printf 'export DB_PASSWORD=%q\n' "$DB_PASSWORD"
  [[ -n "${DB_HOST:-}" ]] && printf 'export DB_HOST=%q\n' "$DB_HOST"
  [[ -n "${DB_PORT:-}" ]] && printf 'export DB_PORT=%q\n' "$DB_PORT"
  [[ -n "${DB_DATABASE:-}" ]] && printf 'export DB_DATABASE=%q\n' "$DB_DATABASE"
  [[ -n "${DB_USERNAME:-}" ]] && printf 'export DB_USERNAME=%q\n' "$DB_USERNAME"
  [[ -n "${RAILS_MASTER_KEY:-}" ]] && printf 'export RAILS_MASTER_KEY=%q\n' "$RAILS_MASTER_KEY"
} > "$ENV_FILE"
chmod 600 "$ENV_FILE"

cat > "$RUNNER" <<RUNNER
#!/usr/bin/env bash
set -e
source "$ENV_FILE"
export PATH="$PATH_VALUE"
cd "$PROJECT_DIR"
exec "$PROJECT_DIR/bin/dev"
RUNNER
chmod 700 "$RUNNER"

cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$LABEL</string>

  <key>ProgramArguments</key>
  <array>
    <string>$RUNNER</string>
  </array>

  <key>WorkingDirectory</key>
  <string>$PROJECT_DIR</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>$PATH_VALUE</string>
    <key>PORT</key>
    <string>3000</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>$LOG_DIR/jump-start-website-dev.log</string>

  <key>StandardErrorPath</key>
  <string>$LOG_DIR/jump-start-website-dev.err.log</string>
</dict>
</plist>
PLIST

chmod 644 "$PLIST"

launchctl bootout "gui/$(id -u)/$LABEL" >/dev/null 2>&1 || true
launchctl bootstrap "gui/$(id -u)" "$PLIST"
launchctl enable "gui/$(id -u)/$LABEL"
launchctl kickstart -k "gui/$(id -u)/$LABEL"

echo
echo "Installed and started $LABEL"
echo "Project: $PROJECT_DIR"
echo "URL:     http://localhost:3000"
echo "Env:     $ENV_FILE (mode 600)"
echo
echo "Logs:"
echo "  $LOG_DIR/jump-start-website-dev.log"
echo "  $LOG_DIR/jump-start-website-dev.err.log"
echo
echo "Status:"
echo "  launchctl print gui/$(id -u)/$LABEL"
